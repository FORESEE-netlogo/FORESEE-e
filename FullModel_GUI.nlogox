    <plot x="951" autoPlotX="true" yMax="0.0" autoPlotY="true" yAxis="cm" y="352" xMin="0.0" height="217" legend="true" xMax="10.0" yMin="-31.0" width="247" xAxis="Time [d]" display="Depth of worms">
