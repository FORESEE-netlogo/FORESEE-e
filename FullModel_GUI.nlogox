  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="lter-ernst2021" repetitions="50" sequentialRunOrder="true" runMetricsEveryStep="true">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition><![CDATA[ticks >= length date-data]]></exitCondition>
      <metrics>
        <metric>count juveniles / width-environment</metric>
        <metric>count adults / width-environment</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="death-model">
          <value value="&quot;SD&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="num-juv">
          <value value="20"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="sublethal-effects">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="tox-parameter">
          <value value="&quot;carbendazim&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="no-user-dialogues">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="species">
          <value value="&quot;L. terrestris&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="folder-scenario">
          <value value="&quot;input/Ernst2021&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="soil-parameter">
          <value value="&quot;natural&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="thickness-litter">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="substance">
          <value value="false"></value>
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="num-adults">
          <value value="5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="width-environment">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="file-tox">
          <value value="&quot;input/input_tox_Lt-Carb.txt&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="file-species">
          <value value="&quot;input/input_species_Lt.txt&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="scenario">
          <value value="&quot;Ernst2021&quot;"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
