;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;                               WURZEN                                    ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup-ernst2021
  set-current-directory "input/Ernst2021"
  (ifelse eco-type = "anecic" [
    set num-adults 5
    set num-juv 20
    set ww-juv 1.5
    set ww-adu 4.3
    set min-distance-between-burrows 20
  ] species = "A. caliginosa" [
    set num-adults 33
    set num-juv 169
    set ww-juv 0.38
    set ww-adu 0.79
  ][
    set num-adults 100
    set num-juv 200
  ])
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;                            Placeholder                                  ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to read-from-folder
  ifelse no-user-dialogues [
    set-current-directory folder-scenario
  ][
    user-message "Choose directory with scenario .txt-files"
    set-current-directory user-directory
  ]
  ifelse num-adults + num-juv > 0 [
    if eco-type = "anecic" [
      if num-adults > width-environment * 100 / min-distance-between-burrows [ set num-adults floor (width-environment * 100 / min-distance-between-burrows)]
      if num-juv > 50 [set num-juv 50]
    ]
  ][
    ifelse eco-type = "anecic" [
      set num-adults floor (width-environment * 100 / min-distance-between-burrows)
      set num-juv num-adults * 4
    ][
      set num-adults 100
      set num-juv 200
    ]
  ]
end

to read-scenario-from-files
  file-open "ini.txt"
  set location file-read
  set latitude file-read
  set day-of-year file-read
  set start-plot file-read
  file-close

  file-open "calendar.txt"
  set date-data file-read
  file-close

  file-open "OM.txt"
  set OM-data file-read
  file-close

  file-open "rho.txt"
  set rho-data file-read
  file-close

  file-open "temp.txt"
  set temperature-data file-read
  file-close

  file-open "theta.txt"
  set theta-data file-read
  file-close
end

to read-species-from-file [file]
  
  let parameters table:make ; create a parameters table
  file-open file ; open file for reading
  
  while [ not file-at-end? ] [ ; read file line by line
    let cols csv:from-row file-read-line ; 
    let par-name item 0 cols ; 1st column is parameter name
    ;let par_value read-from-string item 1 cols ; 2nd column is parameter value
    
    let raw-value item 1 cols
    let par-value raw-value
    
    ;if not member? par-name ["eco-type" "species-group" "deb-model-type"] [
    ;  set par-value read-from-string raw-value
    ;]
    
    table:put parameters par-name par-value ; add to table
  ]
  
  file-close
 
  
  set eco-type  table:get parameters "eco-type"
  
  set undergoes-diapause table:get parameters "undergoes-diapause"
  set min-days-diapause table:get parameters "min-days-diapause"
  set b_diapause table:get parameters "b_diapause"
  set F_m0   table:get parameters "F_m"
  set m_0    table:get parameters "m_0"
  set b_max  table:get parameters "b_max"
  set k_b    table:get parameters "k_b"
  set kap_X  table:get parameters "kap_X"
  set HSK    table:get parameters "HSK" ; TODO: we have both F_m0 and HSK in the parameters file, but if HSK is equivalent to the DEB parameter K (to be verified), we should only have one of both (preferrably F_m0)
  set p_M0   table:get parameters "p_M"
  set v0     table:get parameters "v"
  set k_J0   table:get parameters "k_J"
  set p_Am0  table:get parameters "p_Am"
  set kap    table:get parameters "kap"
  set E_G    table:get parameters "E_G"
  set E_Hp   table:get parameters "E_Hp"
  set E_Hb   table:get parameters "E_Hb"
  set kap_R0 table:get parameters "kap_R"
  set U_E0   table:get parameters "U_E0" ; TODO: initial reserve is given as parameter, but also calculated by maternal effects? can we omit this parameter? (from netlogo code and species input files)
  set del_M  table:get parameters "del_M"
  set d_V    table:get parameters "d_V"
  set w_E    table:get parameters "w_E"
  set mu_E   table:get parameters "mu_E"
  set s_G    table:get parameters "s_G"
  set h_a0   table:get parameters "h_a" 
  set t_0    table:get parameters "t_0"

  set T_A    table:get parameters "T_A"    ; as long as no data available: 0; TODO: does T_A = 0 not break the calculations?
  set T_H    table:get parameters "T_H"    ; as long as no data available: any number
  set T_AH   table:get parameters "T_AH"   ; as long as no data available: 0
  set T_ref  table:get parameters "T_ref"  ; in DEB always 20°C

  ; state variables
  set L_0 table:get parameters "L_0" ; TODO: length at birth is given as parameter, but also calculated by maternal effects? can we remove this parameter? (from netlogo code and species input files)

  set ave_eggs table:get parameters "ave-eggs"
  set cone-distance table:get parameters "cone-distance" 
  set cone-angle-burrow table:get parameters "cone-angle-burrow"
  set cone-angle-litter table:get parameters "cone-angle-litter"
  if eco-type != "anecic" [ set cone-angle cone-angle-burrow]
  set min-distance-between-burrows table:get parameters "min-distance-between-burrows"

  set rate-desic table:get parameters "rate-desic"

  file-close
end

to set-tox-parameters [file]
  file-open file

 ; toxicity parameters
  ; IT
  set k_d_IT file-read
  set h_b_IT file-read
  set m_w_IT file-read
  set beta file-read

  ; SD
  set k_d_SD file-read
  set h_b_SD file-read
  set b_w file-read
  set m_w_SD file-read

  if sublethal-effects [
    ; DEB-TKTD
    ; feeding
    set c01 file-read
    set cT1 file-read
    if cT1 > 0 [ set pMoA-feeding True]
    ; somatic maintenance
    set c02 file-read
    set cT2 file-read
    if cT2 > 0 [set pMoA-somatic-maintenance True]
    ; maturity maintenance
    set c03 file-read
    set cT3 file-read
    if cT3 > 0 [set pMoA-maturity-maintenance True]
    ; cost egg
    set c04 file-read
    set cT4 file-read
    if cT4 > 0 [set pMoA-cost-egg True]
    ; hazard oogenesis
    set c05 file-read
    set cT5 file-read
    if cT5 > 0 [set pMoA-hazard-oogenesis True]
  ]

  file-close
end]]></code>
